{
  "name": "@felores/pi-session-search",
  "version": "0.1.0",
  "description": "Local, read-only conversation search for Pi sessions",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "README.es.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:run": "npm test",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:semantic": "tsx scripts/benchmark-semantic.ts",
    "smoke:load": "tsx scripts/smoke-load.ts",
    "quality": "npm run check && npm test && npm run smoke:load",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "session-search",
    "conversation-search",
    "sqlite",
    "fts5"
  ],
  "license": "MIT",
  "author": "felores",
  "repository": {
    "type": "git",
    "url": "https://github.com/felores/pi-session-search"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.3 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.21.0",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
